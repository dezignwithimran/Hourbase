NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. If unset, the app runs in local demo mode (data persisted in the browser).

# Paddle Billing (recommended). Overlay checkout works from Pakistan.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_client_token
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_PRO_MONTHLY=pri_
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=pri_
NEXT_PUBLIC_PADDLE_PRICE_STUDIO_MONTHLY=pri_
NEXT_PUBLIC_PADDLE_PRICE_STUDIO_YEARLY=pri_
PADDLE_API_KEY=pdl_apikey_
PADDLE_WEBHOOK_SECRET=pdl_ntfset_

# Stripe (optional). Pakistani businesses generally cannot open a Stripe merchant account.
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
